---
import { site } from '../data/site';

const stats = [
  {
    value: site.experienceYears,
    suffix: '+',
    label: 'años de experiencia en contabilidad y administración financiera',
  },
  { value: site.education.length, label: 'títulos profesionales: Contadora Pública y Administradora Financiera' },
  { value: site.certifications.length, label: 'diplomados y certificaciones, incluida QuickBooks ProAdvisor' },
  { value: site.software.length, label: 'herramientas contables y de análisis que domino' },
];
---

<section aria-label="Trayectoria en cifras" class="relative isolate border-b border-line bg-paper">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-grid"></div>
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-14 md:grid-cols-4 md:px-10 md:py-20">
    {
      stats.map((stat, index) => (
        <div style={`--i: ${index}`} class="reveal flex flex-col-reverse border-l border-line pl-5">
          <dt class="mt-3 max-w-[16rem] text-sm leading-relaxed text-ink-soft">{stat.label}</dt>
          <dd class="text-5xl font-medium tracking-[-0.04em] md:text-6xl">
            <span class="sr-only">{stat.value}{stat.suffix}</span>
            <span aria-hidden="true" class="tabular-nums">
              <span class="count-up" style={`--target: ${stat.value}`} />
              {stat.suffix}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
