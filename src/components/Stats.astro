---
import { site } from '../data/site';

const stats = [
  { value: `${site.experienceYears}+`, label: 'años de experiencia en contabilidad y administración financiera' },
  {
    value: String(site.education.length),
    label: 'títulos profesionales: Contadora Pública y Administradora Financiera',
  },
  { value: String(site.certifications.length), label: 'diplomados y certificaciones, incluida QuickBooks ProAdvisor' },
  { value: String(site.software.length), label: 'herramientas contables y de análisis que domino' },
];
---

<section aria-label="Trayectoria en cifras" class="border-b border-line bg-paper">
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-14 md:grid-cols-4 md:px-10 md:py-20">
    {
      stats.map((stat, index) => (
        <div style={`--i: ${index}`} class="reveal flex flex-col-reverse border-l border-line pl-5">
          <dt class="mt-3 max-w-[16rem] text-sm leading-relaxed text-ink-soft">{stat.label}</dt>
          <dd class="text-5xl font-medium tracking-[-0.04em] md:text-6xl">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
