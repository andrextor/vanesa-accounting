---
import { site } from '../data/site';
import { getContent } from '../i18n';

const t = getContent(Astro.currentLocale);
const stats = [
  { value: site.experienceYears, suffix: '+', label: t.stats.years },
  { value: t.education.length, label: t.stats.degrees },
  { value: t.certifications.length, label: t.stats.certifications },
  { value: site.software.length, label: t.stats.tools },
];
---

<section aria-label={t.ui.statsLabel} class="relative isolate border-b border-line bg-paper">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-grid"></div>
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-14 md:grid-cols-4 md:px-10 md:py-20">
    {
      stats.map((stat, index) => (
        <div style={`--i: ${index}`} class="reveal flex flex-col-reverse justify-end border-l border-line pl-5">
          <dt class="mt-3 max-w-[16rem] text-sm leading-relaxed text-ink-soft">{stat.label}</dt>
          <dd class="text-5xl font-medium tracking-[-0.04em] md:text-6xl">
            <span class="sr-only">{stat.value}{stat.suffix}</span>
            <span aria-hidden="true" class="tabular-nums">
              <span class="count-up" style={`--target: ${stat.value}`} />
              {stat.suffix}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
