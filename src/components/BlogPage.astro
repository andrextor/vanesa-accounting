---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  lead: string;
}

const { title, description, eyebrow, heading, lead } = Astro.props;
---

<Layout title={title} description={description}>
  <slot name="head" slot="head" />
  <Header />

  <main id="contenido">
    <section class="relative isolate overflow-clip bg-ink text-white">
      <div aria-hidden="true" class="absolute inset-0 -z-10 bg-noise"></div>
      <div
        aria-hidden="true"
        style="--glow-x: 80%; --glow-y: 40%; --glow-strength: 20%"
        class="absolute inset-0 -z-10 bg-glow"
      >
      </div>
      <div class="mx-auto w-full max-w-7xl px-5 pt-40 pb-16 md:px-10 md:pt-48 md:pb-24">
        <div class="hero-in max-w-3xl">
          <p style="--i: 0" class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-white/85">
            <span aria-hidden="true" class="size-1.5 rounded-full bg-accent-light"></span>
            {eyebrow}
          </p>
          <h1 style="--i: 1" class="mt-5 text-[2.5rem] leading-[1.05] font-medium tracking-[-0.035em] text-balance md:text-6xl">
            {heading}
          </h1>
          <p style="--i: 2" class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">{lead}</p>
        </div>
      </div>
    </section>

    <slot />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
