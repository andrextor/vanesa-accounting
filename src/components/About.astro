---
import { Image } from 'astro:assets';
import portrait from '../assets/portraits/vanesa-reviewing-numbers.jpg';
import { site } from '../data/site';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="sobre-mi" class="scroll-mt-0 bg-paper">
  <div class="mx-auto grid max-w-7xl gap-14 px-5 py-24 md:px-10 md:py-32 lg:grid-cols-[5fr_7fr] lg:gap-20">
    <div class="lg:sticky lg:top-10 lg:self-start">
      <div class="reveal relative">
        <Image
          src={portrait}
          alt={`${site.name} revisando un estado financiero en su escritorio`}
          widths={[480, 768, 1080]}
          sizes="(min-width: 1024px) 35vw, 100vw"
          class="aspect-[4/5] w-full rounded-xl object-cover"
        />
        <span class="absolute top-4 left-4 rounded-full bg-paper/90 px-3 py-1.5 text-xs font-medium text-accent-deep backdrop-blur">
          QuickBooks ProAdvisor
        </span>
        <div class="absolute inset-x-4 bottom-4 rounded-lg bg-paper/90 px-5 py-4 backdrop-blur">
          <p class="font-medium">{site.name}</p>
          <p class="text-sm text-ink-soft">Contadora Pública · Administradora Financiera</p>
        </div>
      </div>
    </div>

    <div>
      <SectionHeading eyebrow="Sobre mí" title={site.about.heading} />
      <div class="reveal mt-6 space-y-4 text-lg leading-relaxed text-ink-soft">
        {site.about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div class="mt-14 space-y-12">
        <div class="reveal">
          <h3 class="text-xs font-medium uppercase tracking-[0.18em] text-ink-soft">Formación académica</h3>
          <ol class="mt-5 grid gap-4 sm:grid-cols-2">
            {
              site.education.map((degree) => (
                <li class="rounded-xl border border-line bg-surface p-6">
                  <p class="text-sm font-medium text-accent tabular-nums">{degree.year}</p>
                  <p class="mt-3 text-xl font-medium tracking-[-0.02em]">{degree.title}</p>
                  <p class="mt-1 text-ink-soft">{degree.institution}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="reveal">
          <h3 class="text-xs font-medium uppercase tracking-[0.18em] text-ink-soft">Diplomados y certificaciones</h3>
          <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {
              site.certifications.map((certification) => (
                <li class="flex gap-3 border-b border-line pb-3">
                  <Icon name="check" class="mt-1 size-4 text-accent" />
                  {certification}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm text-ink-soft">
            Formación complementaria en {site.training.slice(0, -1).join(', ')} y {site.training.at(-1)}.
          </p>
        </div>

        <div class="reveal">
          <h3 class="text-xs font-medium uppercase tracking-[0.18em] text-ink-soft">Experiencia</h3>
          <ol class="mt-5 divide-y divide-line border-y border-line">
            {
              site.experience.map((position) => (
                <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <div>
                    <p class="text-lg font-medium">{position.company}</p>
                    <p class="text-ink-soft">{position.role}</p>
                  </div>
                  {'period' in position && <p class="shrink-0 text-sm text-ink-soft tabular-nums">{position.period}</p>}
                </li>
              ))
            }
          </ol>
        </div>

      </div>
    </div>
  </div>
</section>
