---
import { getContent } from '../i18n';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const t = getContent(Astro.currentLocale);
---

<section id="para-quien" class="relative isolate scroll-mt-0 bg-paper">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-dots"></div>
  <div class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-32">
    <SectionHeading {...t.sections.audiences} />

    <ul class="mt-14 grid gap-4 md:grid-cols-3">
      {
        t.audiences.map((audience, index) => (
          <li
            style={`--i: ${index}`}
            data-scroll-hover
            class="reveal group relative isolate overflow-hidden rounded-xl border border-line bg-linear-to-b from-surface to-paper p-8 transition duration-300 hover:border-accent/40"
          >
            <span
              aria-hidden="true"
              style="--glow-x: 12%; --glow-y: 12%; --glow-strength: 28%"
              class="absolute inset-0 -z-10 bg-glow opacity-0 transition-opacity duration-700 ease-fluid group-hover:opacity-100"
            />
            <span class="grid size-12 place-items-center rounded-lg bg-ink text-accent-light transition duration-300 group-hover:bg-accent group-hover:text-white">
              <Icon name={audience.icon} class="size-6" />
            </span>
            <h3 class="mt-8 text-2xl font-medium tracking-[-0.025em]">{audience.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{audience.description}</p>
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-12 flex flex-col gap-4 border-t border-line pt-8 md:flex-row md:items-center md:gap-8">
      <p class="shrink-0 text-sm font-medium text-ink-soft">{t.ui.sectorsLabel}</p>
      <ul class="flex flex-wrap gap-2">
        {t.sectors.map((sector) => <li class="rounded-full border border-line px-4 py-2 text-sm">{sector}</li>)}
      </ul>
    </div>
  </div>
</section>
