---
import { site, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#para-quien', label: 'Para quién' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-40 px-4 md:px-8">
  <nav
    aria-label="Principal"
    class="pointer-events-auto mx-auto mt-4 flex max-w-7xl items-center justify-between gap-4 rounded-full border border-white/60 bg-paper/80 py-2 pr-2 pl-2 shadow-[0_8px_32px_-12px_rgb(15_27_45/0.35)] backdrop-blur-xl md:mt-5"
  >
    <a href="/" class="pl-3 text-[0.95rem]" aria-label={`${site.name}, inicio`}>
      <Logo />
    </a>

    <div class="relative hidden lg:block">
      <span aria-hidden="true" data-nav-indicator class="nav-indicator absolute top-0 left-0 h-9 rounded-full bg-ink/[0.07]"></span>
      <ul class="relative flex items-center">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                class="flex h-9 items-center rounded-full px-3.5 text-sm text-ink-soft transition-colors duration-500 ease-fluid hover:text-ink aria-[current]:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex items-center gap-1">
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 rounded-full bg-ink px-4 py-2.5 text-sm font-medium text-white transition duration-500 ease-fluid hover:-translate-y-0.5 hover:bg-accent-deep active:translate-y-px sm:inline-flex"
      >
        <Icon name="whatsapp-logo" class="size-4" />
        Agenda una asesoría
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
        class="group relative size-10 rounded-full transition hover:bg-ink/5 lg:hidden"
      >
        <span
          class="absolute top-4 left-3 h-px w-4 bg-ink transition-transform duration-500 ease-fluid group-aria-expanded:translate-y-1 group-aria-expanded:rotate-45"
        ></span>
        <span
          class="absolute top-6 left-3 h-px w-4 bg-ink transition-transform duration-500 ease-fluid group-aria-expanded:-translate-y-1 group-aria-expanded:-rotate-45"
        ></span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu
    class="group/menu pointer-events-auto invisible fixed inset-0 -z-10 flex flex-col justify-center gap-10 bg-paper/85 px-6 opacity-0 backdrop-blur-3xl transition-all duration-700 ease-fluid data-open:visible data-open:opacity-100 lg:hidden"
  >
    <ul class="flex flex-col gap-5">
      {
        links.map((link, index) => (
          <li
            class="translate-y-10 opacity-0 transition-all duration-700 ease-fluid group-data-open/menu:translate-y-0 group-data-open/menu:opacity-100"
            style={`transition-delay: ${100 + index * 50}ms`}
          >
            <a href={link.href} data-menu-link class="text-5xl font-medium tracking-[-0.04em] text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div
      class="flex translate-y-10 flex-col gap-3 opacity-0 transition-all delay-[400ms] duration-700 ease-fluid group-data-open/menu:translate-y-0 group-data-open/menu:opacity-100"
    >
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-max items-center gap-2 rounded-full bg-ink px-5 py-3 font-medium text-white"
      >
        <Icon name="whatsapp-logo" class="size-5" />
        Agenda una asesoría
      </a>
      <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-ink-soft">
        <Icon name="envelope-simple" class="size-5" />
        {site.email}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const setOpen = (open: boolean): void => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    menu.toggleAttribute('data-open', open);
    document.documentElement.classList.toggle('overflow-hidden', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  for (const link of document.querySelectorAll('[data-menu-link]')) {
    link.addEventListener('click', () => setOpen(false));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // A pill slides under the link of the section crossing the middle of the viewport.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');

  const moveIndicator = (): void => {
    if (!indicator) return;
    const active = navLinks.find((link) => link.hasAttribute('aria-current'));
    if (!active) {
      indicator.removeAttribute('data-visible');
      return;
    }
    indicator.toggleAttribute('data-instant', !indicator.hasAttribute('data-visible'));
    indicator.style.setProperty('--x', `${active.offsetLeft}px`);
    indicator.style.setProperty('--w', `${active.offsetWidth}px`);
    void indicator.offsetWidth;
    indicator.removeAttribute('data-instant');
    indicator.setAttribute('data-visible', '');
  };

  const setActive = (href: string | null): void => {
    for (const link of navLinks) {
      if (link.getAttribute('href') === href) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    moveIndicator();
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const href = `#${entry.target.id}`;
          setActive(navLinks.some((link) => link.getAttribute('href') === href) ? href : null);
        }
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  for (const section of document.querySelectorAll<HTMLElement>('main > section')) spy.observe(section);

  const list = navLinks[0]?.closest('ul');
  if (list) new ResizeObserver(moveIndicator).observe(list);
</script>

<style>
  .nav-indicator {
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    opacity: 0;
    transition:
      transform 600ms var(--ease-fluid),
      width 600ms var(--ease-fluid),
      opacity 300ms var(--ease-fluid);
  }

  .nav-indicator[data-visible] {
    opacity: 1;
  }

  .nav-indicator[data-instant] {
    transition: none;
  }
</style>
