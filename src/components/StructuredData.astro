---
import { site } from '../data/site';
import { getContent, htmlLang, resolveLocale } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = getContent(locale);
const url = new URL(Astro.url.pathname, Astro.site).href;
const personId = `${url}#person`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AccountingService',
      '@id': `${url}#business`,
      name: `${site.name} · ${t.role}`,
      url,
      telephone: site.phone,
      email: site.email,
      areaServed: { '@type': 'Country', name: 'Colombia' },
      founder: { '@id': personId },
      knowsAbout: t.services.map((service) => service.title),
      sameAs: [site.linkedin],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: t.role,
      url,
      email: site.email,
      telephone: site.phone,
      sameAs: [site.linkedin],
      hasCredential: t.education.map((degree) => ({
        '@type': 'EducationalOccupationalCredential',
        name: degree.title,
        recognizedBy: { '@type': 'CollegeOrUniversity', name: degree.institution },
      })),
      alumniOf: t.education.map((degree) => ({ '@type': 'CollegeOrUniversity', name: degree.institution })),
    },
    {
      '@type': 'WebSite',
      '@id': `${url}#website`,
      url,
      name: t.meta.title,
      inLanguage: htmlLang[locale],
      publisher: { '@id': personId },
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
