---
import { getImage } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import portrait from '../assets/portraits/vanesa-wide.jpg';
import { site } from '../data/site';
import { getContent, htmlLang, resolveLocale } from '../i18n';
import type { Faq, Service } from '../i18n/content';

interface Props {
  service?: Service;
  faq?: Faq[];
}

const { service, faq } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = getContent(locale);
const url = getAbsoluteLocaleUrl(locale);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const id = (fragment: string): string => new URL(`/#${fragment}`, Astro.site).href;
const personId = id('person');
// Same render as the Open Graph image in Layout, so the build emits one file.
const image = new URL(
  (await getImage({ src: portrait, format: 'jpg', width: 1200, height: 630, fit: 'cover' })).src,
  Astro.site,
).href;
const areaServed = [
  ...site.inPersonCities.map((name) => ({ '@type': 'City', name })),
  ...site.remoteCountries.map((name) => ({ '@type': 'Country', name })),
];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AccountingService',
      '@id': id('business'),
      name: `${site.name} · ${t.role}`,
      url,
      image,
      telephone: site.phone,
      email: site.email,
      areaServed,
      founder: { '@id': personId },
      knowsAbout: t.services.map((service) => service.title),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.sections.services.eyebrow,
        itemListElement: t.services.map((service) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: service.title, description: service.description },
        })),
      },
      sameAs: [site.linkedin, site.googleBusiness],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: t.role,
      url,
      image,
      email: site.email,
      telephone: site.phone,
      sameAs: [site.linkedin],
      hasCredential: t.education.map((degree) => ({
        '@type': 'EducationalOccupationalCredential',
        name: degree.title,
        recognizedBy: { '@type': 'CollegeOrUniversity', name: degree.institution },
      })),
      alumniOf: t.education.map((degree) => ({ '@type': 'CollegeOrUniversity', name: degree.institution })),
    },
    {
      '@type': 'WebSite',
      '@id': id('website'),
      url,
      name: t.meta.title,
      inLanguage: htmlLang[locale],
      publisher: { '@id': personId },
    },
    ...(service
      ? [
          {
            '@type': 'Service',
            '@id': `${pageUrl}#service`,
            name: service.title,
            description: service.description,
            url: pageUrl,
            provider: { '@id': id('business') },
            areaServed,
          },
        ]
      : []),
    ...(faq
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${pageUrl}#faq`,
            mainEntity: faq.map(({ question, answer }) => ({
              '@type': 'Question',
              name: question,
              acceptedAnswer: { '@type': 'Answer', text: answer },
            })),
          },
        ]
      : []),
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
