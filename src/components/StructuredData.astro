---
import { site } from '../data/site';

const url = Astro.site?.href ?? '/';
const personId = `${url}#person`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AccountingService',
      '@id': `${url}#business`,
      name: `${site.name} · ${site.role}`,
      url,
      telephone: site.phone,
      email: site.email,
      areaServed: { '@type': 'Country', name: 'Colombia' },
      founder: { '@id': personId },
      knowsAbout: site.services.map((service) => service.title),
      sameAs: [site.linkedin],
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: site.role,
      url,
      email: site.email,
      telephone: site.phone,
      sameAs: [site.linkedin],
      hasCredential: site.education.map((degree) => ({
        '@type': 'EducationalOccupationalCredential',
        name: degree.title,
        recognizedBy: { '@type': 'CollegeOrUniversity', name: degree.institution },
      })),
      alumniOf: site.education.map((degree) => ({ '@type': 'CollegeOrUniversity', name: degree.institution })),
    },
    {
      '@type': 'WebSite',
      '@id': `${url}#website`,
      url,
      name: site.title,
      inLanguage: 'es-CO',
      publisher: { '@id': personId },
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
