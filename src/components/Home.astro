---
import Layout from '../layouts/Layout.astro';
import About from './About.astro';
import Audiences from './Audiences.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Process from './Process.astro';
import Services from './Services.astro';
import Stats from './Stats.astro';
import StructuredData from './StructuredData.astro';
import ToolsMarquee from './ToolsMarquee.astro';
import WhatsAppButton from './WhatsAppButton.astro';
---

<Layout>
  <StructuredData slot="head" />
  <Header />

  <main id="contenido">
    <Hero />
    <Stats />
    <ToolsMarquee />
    <Services />
    <Audiences />
    <Process />
    <About />
    <Contact />
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
