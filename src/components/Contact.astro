---
import { getImage } from 'astro:assets';
import wide from '../assets/portraits/vanesa-wide.jpg';
import { site, whatsappUrl } from '../data/site';
import { getContent } from '../i18n';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const t = getContent(Astro.currentLocale);
const background = await getImage({ src: wide, format: 'webp', width: 1600 });

const channels = [
  { label: 'WhatsApp', value: site.phone, href: whatsappUrl(t.whatsapp.greeting), external: true },
  { label: t.ui.email, value: site.email, href: `mailto:${site.email}`, external: false },
];
---

<section id="contacto" class="relative isolate scroll-mt-0 overflow-clip bg-ink text-white">
  <img
    src={background.src}
    alt=""
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-20 hidden size-full object-cover object-right opacity-60 md:block"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-r from-ink via-ink/90 to-ink/30"></div>
  <div
    aria-hidden="true"
    class="absolute top-1/2 left-1/2 -z-10 hidden size-[120vmax] -translate-1/2 bg-aurora motion-safe:animate-aurora md:block"
  >
  </div>
  <div
    aria-hidden="true"
    style="--glow-x: 85%; --glow-y: 15%; --glow-strength: 20%"
    class="absolute inset-0 -z-10 bg-glow md:hidden"
  >
  </div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-noise"></div>

  <div class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-36">
    <SectionHeading tone="dark" {...t.sections.contact} />
    <ul class="mt-12 grid max-w-2xl gap-4 sm:grid-cols-2">
      {
        channels.map((channel, index) => (
          <li style={`--i: ${index}`} class="reveal">
            <a
              href={channel.href}
              {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="group flex items-center justify-between gap-4 rounded-xl border border-white/15 bg-white/5 p-6 backdrop-blur transition duration-300 hover:border-white/40 hover:bg-white/10"
            >
              <span class="min-w-0">
                <span class="block text-sm text-white/60">{channel.label}</span>
                <span class="mt-1 block truncate text-lg font-medium">{channel.value}</span>
              </span>
              <Icon name="arrow-right" class="size-5 transition duration-300 group-hover:translate-x-1" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
