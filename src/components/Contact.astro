---
import { getImage } from 'astro:assets';
import wide from '../assets/portraits/vanesa-wide.jpg';
import { site, whatsappUrl } from '../data/site';
import { getContent } from '../i18n';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const t = getContent(Astro.currentLocale);
const background = await getImage({ src: wide, format: 'webp', width: 1600 });

const channels = [
  { label: 'WhatsApp', value: site.phone, href: whatsappUrl(t.whatsapp.greeting), external: true },
  { label: t.ui.email, value: site.email, href: `mailto:${site.email}`, external: false },
];
// ponytail: FormSubmit relays the form to the business inbox; move to an own endpoint if it ever needs more than that.
const formAction = `https://formsubmit.co/${site.email}`;
const fieldClass =
  'w-full rounded-xl border border-white/15 bg-white/10 px-4 py-3 text-white transition hover:border-white/30 focus:border-white/60 focus:bg-white/15 focus:outline-none';
---

<section id="contacto" class="relative isolate scroll-mt-0 overflow-clip bg-ink text-white">
  <img
    src={background.src}
    alt=""
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-20 hidden size-full object-cover object-right opacity-60 md:block"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-r from-ink via-ink/90 to-ink/30"></div>
  <div
    aria-hidden="true"
    class="absolute top-1/2 left-1/2 -z-10 hidden size-[120vmax] -translate-1/2 bg-aurora motion-safe:animate-aurora md:block"
  >
  </div>
  <div
    aria-hidden="true"
    style="--glow-x: 85%; --glow-y: 15%; --glow-strength: 20%"
    class="absolute inset-0 -z-10 bg-glow md:hidden"
  >
  </div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-noise"></div>

  <div class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-36">
    <SectionHeading tone="dark" {...t.sections.contact} />
    <div class="mt-12 max-w-2xl">
      <form
        method="post"
        action={formAction}
        data-contact-form
        class="reveal grid gap-4"
      >
        <input type="hidden" name="_subject" value={t.form.subject} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <div data-fields class="grid gap-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid gap-1.5 text-sm text-white/60">
              {t.form.name}
              <input type="text" name="name" required autocomplete="name" class={fieldClass} />
            </label>
            <label class="grid gap-1.5 text-sm text-white/60">
              {t.form.email}
              <input type="email" name="email" required autocomplete="email" class={fieldClass} />
            </label>
          </div>
          <label class="grid gap-1.5 text-sm text-white/60">
            {t.form.phone}
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" class={fieldClass} />
          </label>
          <label class="grid gap-1.5 text-sm text-white/60">
            {t.form.message}
            <textarea name="message" required rows="4" class={fieldClass}></textarea>
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            data-submit
            data-sending={t.form.sending}
            class="group inline-flex items-center gap-2 rounded bg-white px-5 py-3.5 font-medium text-ink transition hover:bg-white/90 disabled:opacity-60"
          >
            {t.form.send}
            <Icon name="arrow-right" class="size-5 transition duration-300 group-hover:translate-x-1" />
          </button>
          <p
            role="status"
            aria-live="polite"
            data-status
            data-success={t.form.success}
            data-error={t.form.error}
            data-limit={t.form.limit}
            class="text-base text-white/80"
          >
          </p>
        </div>
      </form>
      <div aria-hidden="true" class="my-10 h-px bg-white/15"></div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          channels.map((channel, index) => (
            <li style={`--i: ${index}`} class="reveal">
              <a
                href={channel.href}
                {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                data-scroll-hover
                class="group flex items-center justify-between gap-4 rounded-xl border border-white/15 bg-white/5 p-6 backdrop-blur transition duration-300 hover:border-white/40 hover:bg-white/10"
              >
                <span class="min-w-0">
                  <span class="block text-sm text-white/60">{channel.label}</span>
                  <span class="mt-1 block truncate text-lg font-medium">{channel.value}</span>
                </span>
                <Icon name="arrow-right" class="size-5 transition duration-300 group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const button = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const status = form?.querySelector<HTMLParagraphElement>('[data-status]');
  const fields = form?.querySelector<HTMLElement>('[data-fields]');
  const sentKey = 'contact-sent-at';
  const dayMs = 86_400_000;

  // ponytail: per-browser daily limit, enough to stop accidental double sends; real rate limiting belongs server side.
  const sentToday = (): boolean => {
    try {
      return Date.now() - Number(localStorage.getItem(sentKey)) < dayMs;
    } catch {
      return false;
    }
  };
  const markSent = (): void => {
    try {
      localStorage.setItem(sentKey, String(Date.now()));
    } catch {}
  };
  const showDone = (message: string | undefined): void => {
    if (!fields || !button || !status) return;
    fields.hidden = true;
    button.hidden = true;
    status.textContent = message ?? '';
  };

  if (sentToday()) showDone(status?.dataset.limit);

  // Without JS the form still posts to FormSubmit, which shows its own confirmation page.
  form?.addEventListener('submit', async (event) => {
    if (!button || !status) return;
    event.preventDefault();
    const label = button.innerHTML;
    button.disabled = true;
    button.textContent = button.dataset.sending ?? '';
    status.textContent = '';
    try {
      const response = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      markSent();
      showDone(status.dataset.success);
    } catch {
      status.textContent = status.dataset.error ?? '';
    } finally {
      button.disabled = false;
      button.innerHTML = label;
    }
  });
</script>
