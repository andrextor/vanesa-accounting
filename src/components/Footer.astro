---
import { site, whatsappUrl } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const nav = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#para-quien', label: 'Para quién' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="bg-ink text-white">
  <div class="mx-auto grid max-w-7xl gap-10 border-t border-white/10 px-5 py-14 md:grid-cols-[2fr_1fr_1fr] md:px-10">
    <div>
      <a href="/" class="inline-block text-2xl" aria-label={`${site.name}, inicio`}>
        <Logo tone="dark" withRole />
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">{site.flagship}.</p>
    </div>
    <nav aria-label="Pie de página">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/50">Navegación</p>
      <ul class="mt-4 space-y-2 text-sm">
        {nav.map((item) => <li><a href={item.href} class="text-white/75 transition hover:text-white">{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/50">Contacto</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="text-white/75 transition hover:text-white">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all text-white/75 transition hover:text-white">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-6 text-xs text-white/50 sm:flex-row sm:justify-between md:px-10">
      <p>© {year} {site.name} · {site.role} · {site.city}</p>
      <p>
        Sitio creado por{' '}
        <a href="https://landak.pro/" target="_blank" rel="noopener" class="underline underline-offset-4 transition hover:text-white">Landak Studio</a>
      </p>
    </div>
  </div>
</footer>
