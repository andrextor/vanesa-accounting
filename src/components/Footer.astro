---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { site, whatsappUrl } from '../data/site';
import { getContent, resolveLocale } from '../i18n';
import Logo from './Logo.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getContent(locale);
const year = new Date().getFullYear();
const home = getRelativeLocaleUrl(locale);
---

<footer class="relative isolate bg-linear-to-b from-ink to-[#070e1a] text-white">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-noise"></div>
  <div class="mx-auto grid max-w-7xl gap-10 border-t border-white/10 px-5 py-14 md:grid-cols-[2fr_1fr_1fr] md:px-10">
    <div>
      <a href={home} class="inline-block text-2xl">
        <Logo tone="dark" withRole />
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">{t.flagship}.</p>
    </div>
    <nav aria-label={t.ui.footerNav}>
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/50">{t.ui.navigation}</p>
      <ul class="mt-4 space-y-2 text-sm">
        {t.nav.map((item) => <li><a href={`${home}${item.href}`} class="text-white/75 transition hover:text-white">{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-white/50">{t.ui.contact}</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={whatsappUrl(t.whatsapp.greeting)} target="_blank" rel="noopener noreferrer" class="text-white/75 transition hover:text-white">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="break-all text-white/75 transition hover:text-white">{site.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 pt-6 pb-24 text-xs text-white/50 sm:flex-row sm:justify-between md:px-10 md:pb-6">
      <p>© {year} {site.name} · {t.role} · {t.location}</p>
      <p>
        {t.ui.createdBy}{' '}
        <a href="https://landak.pro/" target="_blank" rel="noopener" class="underline underline-offset-4 transition hover:text-white">Landak Studio</a>
      </p>
    </div>
  </div>
</footer>
