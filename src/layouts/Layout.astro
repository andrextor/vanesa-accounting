---
import { Font, getImage } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import ogSource from '../assets/portraits/vanesa-wide.jpg';
import { site } from '../data/site';
import { defaultLocale, getContent, htmlLang, locales, ogLocale, resolveLocale } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = getContent(locale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: ogSource, format: 'jpg', width: 1200, height: 630, fit: 'cover' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
const ogAlt = `${site.name}, ${t.role.toLowerCase()}`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1b2d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="canonical" href={canonical} />
    {locales.map((code) => <link rel="alternate" hreflang={htmlLang[code]} href={getAbsoluteLocaleUrl(code)} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale)} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <Font cssVariable="--font-instrument-sans" preload />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only z-50 rounded bg-ink px-4 py-3 text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t.ui.skipToContent}
    </a>
    <slot />
  </body>
</html>
