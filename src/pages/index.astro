---
import { site, whatsappUrl } from '../data/site';
import Layout from '../layouts/Layout.astro';

const nav = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#proceso', label: 'Proceso' },
  { href: '#contacto', label: 'Contacto' },
];
const year = new Date().getFullYear();
---

<Layout>
  <header class="sticky top-0 z-20 border-b border-line/70 bg-paper/85 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
      <a href="#" class="font-serif text-xl font-semibold tracking-tight">{site.name}</a>
      <nav aria-label="Principal" class="hidden gap-8 text-sm font-medium text-ink-soft md:flex">
        {nav.map((item) => <a href={item.href} class="transition hover:text-sage">{item.label}</a>)}
      </nav>
      <a
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-ink px-5 py-2 text-sm font-semibold text-paper transition hover:bg-sage-deep"
      >
        Agenda una asesoría
      </a>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="absolute -right-32 -top-32 size-[28rem] rounded-full bg-mist"></div>
      <div class="relative mx-auto max-w-6xl px-5 py-24 md:py-36">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sage">{site.hero.eyebrow}</p>
        <h1 class="mt-5 max-w-3xl font-serif text-4xl leading-tight md:text-6xl">{site.hero.heading}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{site.hero.lead}</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-sage px-7 py-3 font-semibold text-white transition hover:bg-sage-deep"
          >
            Hablemos por WhatsApp
          </a>
          <a href="#servicios" class="rounded-full border border-ink/20 px-7 py-3 font-semibold transition hover:border-ink">
            Ver servicios
          </a>
        </div>
      </div>
    </section>

    <section id="servicios" class="scroll-mt-20 border-t border-line bg-white">
      <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
        <h2 class="font-serif text-3xl md:text-4xl">Servicios</h2>
        <ul class="mt-12 grid gap-6 sm:grid-cols-2">
          {
            site.services.map((service, index) => (
              <li class="rounded-2xl border border-line p-8 transition hover:border-sage/50 hover:shadow-sm">
                <span class="font-serif text-sm text-sage">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="mt-3 text-xl font-semibold">{service.title}</h3>
                <p class="mt-3 leading-relaxed text-ink-soft">{service.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="sobre-mi" class="scroll-mt-20 bg-mist">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 md:grid-cols-[2fr_3fr] md:py-28">
        <div aria-hidden="true" class="aspect-[4/5] rounded-3xl bg-sage/20"></div>
        <div>
          <h2 class="font-serif text-3xl md:text-4xl">{site.about.heading}</h2>
          <p class="mt-6 text-lg leading-relaxed text-ink-soft">{site.about.body}</p>
        </div>
      </div>
    </section>

    <section id="proceso" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
        <h2 class="font-serif text-3xl md:text-4xl">Cómo trabajamos</h2>
        <ol class="mt-12 grid gap-10 md:grid-cols-3">
          {
            site.steps.map((step, index) => (
              <li class="border-t-2 border-sage pt-6">
                <span class="font-serif text-3xl text-sage">{index + 1}</span>
                <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
                <p class="mt-2 text-ink-soft">{step.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="contacto" class="scroll-mt-20 bg-ink text-paper">
      <div class="mx-auto max-w-6xl px-5 py-20 text-center md:py-28">
        <h2 class="font-serif text-3xl md:text-5xl">¿Listo para poner tus cuentas en orden?</h2>
        <p class="mx-auto mt-5 max-w-xl text-paper/75">La primera conversación es sin compromiso.</p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-sage px-7 py-3 font-semibold text-white transition hover:bg-sage-deep"
          >
            Escríbeme por WhatsApp
          </a>
          <a href={`mailto:${site.email}`} class="rounded-full border border-paper/30 px-7 py-3 font-semibold transition hover:border-paper">
            {site.email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-ink text-sm text-paper/60">
    <div class="mx-auto flex max-w-6xl flex-col justify-between gap-2 border-t border-paper/10 px-5 py-8 md:flex-row">
      <p>© {year} {site.name} · {site.role}</p>
      <p>{site.city}</p>
    </div>
  </footer>
</Layout>
