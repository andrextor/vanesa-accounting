---
import { getCollection } from 'astro:content';
import BlogPage from '../../components/BlogPage.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { blogPath } from '../../i18n';

const posts = (await getCollection('blog')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const formatDate = new Intl.DateTimeFormat('es-CO', { dateStyle: 'long', timeZone: 'UTC' }).format;
---

<BlogPage
  title={`Blog de impuestos y contabilidad · ${site.name}`}
  description="Guías claras sobre declaración de renta, topes de la DIAN y contabilidad para personas naturales y pequeñas empresas en Colombia."
  eyebrow="Blog"
  heading="Impuestos y contabilidad, explicados claro."
  lead="Guías prácticas para personas naturales y pequeñas empresas en Colombia."
>
  <section class="relative isolate bg-paper">
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-dots"></div>
    <ul class="mx-auto max-w-4xl divide-y divide-line border-y border-line px-5 md:px-10">
      {
        posts.map((post) => (
          <li>
            <a href={`${blogPath}${post.id}/`} class="group block py-10">
              <time datetime={post.data.published.toISOString()} class="text-sm text-ink-soft">
                {formatDate(post.data.published)}
              </time>
              <h2 class="mt-3 text-2xl font-medium tracking-[-0.025em] text-balance transition-colors group-hover:text-accent-deep md:text-3xl">
                {post.data.title}
              </h2>
              <p class="mt-3 leading-relaxed text-ink-soft">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-accent-deep">
                Leer artículo
                <Icon name="arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BlogPage>
