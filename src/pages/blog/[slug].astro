---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPage from '../../components/BlogPage.astro';
import Icon from '../../components/Icon.astro';
import StructuredData from '../../components/StructuredData.astro';
import { site, whatsappUrl } from '../../data/site';
import { blogPath } from '../../i18n';

export const getStaticPaths = async () =>
  (await getCollection('blog')).map((post) => ({ params: { slug: post.id }, props: { post } }));

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, published, updated } = post.data;
const { Content } = await render(post);
const formatDate = new Intl.DateTimeFormat('es-CO', { dateStyle: 'long', timeZone: 'UTC' }).format;
const inquiry = whatsappUrl(`Hola Vanesa, leí tu artículo "${title}" y tengo una pregunta.`);
---

<BlogPage
  title={`${title} · ${site.name}`}
  description={description}
  eyebrow={`Blog · ${formatDate(updated ?? published)}`}
  heading={title}
  lead={description}
>
  <StructuredData slot="head" article={{ headline: title, description, published, updated }} />

  <article class="bg-paper">
    <div class="article mx-auto max-w-3xl px-5 py-16 md:px-10 md:py-24">
      <Content />
    </div>
  </article>

  <section class="bg-surface">
    <div class="mx-auto flex max-w-3xl flex-col items-start gap-6 px-5 py-16 md:px-10">
      <p class="text-2xl font-medium tracking-[-0.025em] text-balance md:text-3xl">¿Tienes dudas sobre tu caso?</p>
      <p class="leading-relaxed text-ink-soft">
        Escríbeme por WhatsApp. Soy {site.name}, contadora pública, y te respondo personalmente.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={inquiry}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded bg-ink px-5 py-3.5 font-medium text-white transition hover:bg-accent-deep"
        >
          <Icon name="whatsapp-logo" class="size-5" />
          Escríbeme por WhatsApp
        </a>
        <a href={blogPath} class="text-sm font-medium text-ink-soft underline underline-offset-4 hover:text-ink">
          Ver más artículos
        </a>
      </div>
    </div>
  </section>
</BlogPage>
